# Copy to .env. Leave OPENAI_API_KEY empty to run in rules-only mode.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
CORS_ORIGINS=*

# Base URL the frontend container is built with; the browser calls this
# directly, so it must be reachable from your machine, not just from Docker.
VITE_API_URL=http://localhost:5000/api
